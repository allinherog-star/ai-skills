    },
    "inclusionCriteriaNotes": {
      "type": "string",
      "title": "纳排标准与证据限制",
      "x-rows": 3,
      "description": "补充时间范围、研究类型、排除条件、语言限制和偏倚关注点。",
      "x-component": "Textarea"
    },
    "literatureEvidenceFile": {
      "type": "string",
      "title": "上传文献表格",
      "format": "binary",
      "x-accept": ".docx,.pdf,.md,.txt,.xlsx,.csv,.png,.jpg,.jpeg",
      "x-max-size": 20971520,
      "description": "上传文献清单、摘要导出、证据表或阅读笔记。",
      "x-component": "FileUpload"
    },
    "literatureAbstractsText": {
      "type": "string",
      "title": "文献摘要与问题",
      "x-rows": 10,
      "description": "粘贴研究问题、PICO、文献摘要、结论片段或证据摘录。",
      "x-component": "Textarea"
    },
    "researchQuestionContext": {
      "type": "string",
      "title": "研究问题与使用场景",
      "x-rows": 3,
      "description": "说明疾病/干预/人群/结局、内部汇报或内容支持目的。",
      "x-component": "Textarea"
    }
