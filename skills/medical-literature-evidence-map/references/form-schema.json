      "x-options": [
        {
          "icon": "Target",
          "color": "blue",
          "group": "整理重点",
          "label": "证据分层",
          "value": "证据分层",
          "description": "重点处理证据分层"
        },
        {
          "icon": "ListChecks",
          "color": "green",
          "group": "整理重点",
          "label": "研究差异",
          "value": "研究差异",
          "description": "重点处理研究差异"
        },
        {
          "icon": "Award",
          "color": "blue",
          "group": "整理重点",
          "label": "结论边界",
          "value": "结论边界",
          "description": "重点处理结论边界"
        },
        {
          "icon": "ClipboardList",
          "color": "green",
          "group": "整理重点",
          "label": "待补文献",
          "value": "待补文献",
