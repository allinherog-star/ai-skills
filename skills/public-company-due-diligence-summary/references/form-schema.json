        },
        {
          "icon": "ListChecks",
          "color": "green",
          "group": "摘要重点",
          "label": "风险事件",
          "value": "风险事件",
          "description": "重点处理风险事件"
        },
        {
          "icon": "Award",
          "color": "blue",
          "group": "摘要重点",
          "label": "治理结构",
          "value": "治理结构",
          "description": "重点处理治理结构"
        },
        {
          "icon": "ClipboardList",
          "color": "green",
          "group": "摘要重点",
          "label": "待核实清单",
          "value": "待核实清单",
