      "x-component": "FileUpload"
    },
    "watchItemNotes": {
      "type": "string",
      "title": "关注事项与排除范围",
      "x-rows": 3,
      "description": "补充重点关注、已知风险、不得下结论范围和需人工核验事项。",
      "x-component": "Textarea"
    },
    "diligenceContext": {
      "type": "string",
      "title": "尽调目的与市场背景",
      "x-rows": 3,
      "description": "说明公司、行业、市场、合作/投资/采购目的和时间范围。",
      "x-component": "Textarea"
    },
    "companyDisclosureLink": {
      "type": "string",
      "title": "公开披露链接",
      "format": "uri",
      "description": "填写公开可访问的交易所公告、公司官网、监管披露或新闻链接。"
    },
    "companyDisclosureText": {
      "type": "string",
      "title": "公司公开资料摘录",
