    "primaryTabs": [
      {
        "id": "paste",
        "icon": "FileText",
        "field": "rolePostingText",
        "label": "JD文本"
      },
      {
        "id": "upload",
        "icon": "Upload",
        "field": "jdDocumentFile",
        "label": "上传JD资料"
      },
      {
        "id": "link",
        "icon": "Link",
        "field": "hiringPlanLink",
        "label": "招聘参考链接"
      }
    ],
    "primaryField": "rolePostingText",
    "advancedLabel": "补充场景",
    "primaryControlFields": [
      "jdOptimizeFocus"
    ],
    "advancedControlFields": [
      "roleContext",
      "compensationConstraintNotes"
    ]
  },
  "properties": {
    "roleContext": {
      "type": "string",
      "title": "岗位与团队背景",
      "x-rows": 3,
      "description": "说明职级、汇报线、业务阶段、城市、薪酬区间和招聘紧急度。",
      "x-component": "Textarea"
    },
    "hiringPlanLink": {
      "type": "string",
      "title": "招聘参考链接",
      "format": "uri",
      "description": "填写公开可访问的招聘页、岗位页、团队介绍或竞品JD链接。"
    },
    "jdDocumentFile": {
      "type": "string",
      "title": "上传JD资料",
      "format": "binary",
      "x-accept": ".docx,.pdf,.md,.txt,.xlsx,.csv,.png,.jpg,.jpeg",
      "x-max-size": 20971520,
      "description": "上传JD草稿、岗位画像、绩效要求、竞品JD或招聘复盘。",
      "x-component": "FileUpload"
    },
    "jdOptimizeFocus": {
      "enum": [
        "吸引力",
        "要求清晰",
        "合规表达",
        "筛选标准"
      ],
      "type": "string",
      "title": "优化重点",
      "default": "吸引力",
      "x-options": [
        {
          "icon": "Target",
          "color": "blue",
          "group": "优化重点",
          "label": "吸引力",
          "value": "吸引力",
          "description": "重点处理吸引力"
        },
        {
          "icon": "ListChecks",
          "color": "green",
          "group": "优化重点",
          "label": "要求清晰",
          "value": "要求清晰",
          "description": "重点处理要求清晰"
        },
        {
          "icon": "Award",
          "color": "blue",
          "group": "优化重点",
          "label": "合规表达",
          "value": "合规表达",
          "description": "重点处理合规表达"
        },
        {
          "icon": "ClipboardList",
          "color": "green",
          "group": "优化重点",
          "label": "筛选标准",
          "value": "筛选标准",
          "description": "重点处理筛选标准"
        }
      ],
      "description": "选择本次中文 JD 优化最需要优先处理的方向。"
    },
    "rolePostingText": {
      "type": "string",
      "title": "JD文本",
      "x-rows": 10,
      "description": "粘贴岗位职责、任职要求、加分项、团队介绍和招聘亮点。",
      "x-component": "Textarea"
    },
    "compensationConstraintNotes": {
      "type": "string",
      "title": "招聘约束与合规注意",
      "x-rows": 3,
      "description": "补充硬性要求、不能承诺内容、年龄/性别等敏感限制排除要求。",
      "x-component": "Textarea"
    }
