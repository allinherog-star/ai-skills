      {
        "id": "upload",
        "icon": "Upload",
        "field": "policyDocumentFile",
        "label": "上传保单资料"
      },
      {
        "id": "link",
        "icon": "Link",
        "field": "insurerPageLink",
        "label": "保险产品链接"
      }
