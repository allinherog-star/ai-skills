        "field": "financePromoText",
        "label": "金融营销文案"
      },
      {
        "id": "upload",
        "icon": "Upload",
        "field": "financePromoFile",
        "label": "上传营销资料"
      },
      {
        "id": "link",
        "icon": "Link",
        "field": "promoPageLink",
        "label": "营销页面链接"
      }
