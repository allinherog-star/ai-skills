  "properties": {
    "promoPageLink": {
      "type": "string",
      "title": "营销页面链接",
      "format": "uri",
      "description": "填写公开可访问的活动页、产品页、公告或投放落地页。"
    },
    "financePromoFile": {
      "type": "string",
      "title": "上传营销资料",
      "format": "binary",
      "x-accept": ".docx,.pdf,.md,.txt,.xlsx,.csv,.png,.jpg,.jpeg",
      "x-max-size": 20971520,
      "description": "上传营销海报、落地页稿、产品说明、审稿表或活动方案。",
      "x-component": "FileUpload"
    },
    "financePromoText": {
      "type": "string",
      "title": "金融营销文案",
      "x-rows": 10,
      "description": "粘贴海报文案、产品卖点、收益/风险表述、活动页或投放素材。",
      "x-component": "Textarea"
    },
    "channelAudienceNotes": {
      "type": "string",
      "title": "受众与禁用表达",
      "x-rows": 3,
      "description": "补充风险揭示、历史业绩口径、不可承诺收益和必须保留声明。",
      "x-component": "Textarea"
    },
    "financeComplianceFocus": {
      "enum": [
        "收益表述",
        "风险揭示",
        "适当性提示",
        "安全改写"
      ],
      "type": "string",
      "title": "审查重点",
      "default": "收益表述",
      "x-options": [
        {
          "icon": "Target",
          "color": "blue",
          "group": "审查重点",
          "label": "收益表述",
          "value": "收益表述",
          "description": "重点处理收益表述"
        },
        {
          "icon": "ListChecks",
          "color": "green",
          "group": "审查重点",
          "label": "风险揭示",
          "value": "风险揭示",
          "description": "重点处理风险揭示"
        },
        {
          "icon": "Award",
          "color": "blue",
          "group": "审查重点",
          "label": "适当性提示",
          "value": "适当性提示",
          "description": "重点处理适当性提示"
        },
        {
          "icon": "Globe",
          "color": "green",
          "group": "审查重点",
          "label": "安全改写",
          "value": "安全改写",
          "description": "重点处理安全改写"
        }
      ],
      "description": "选择本次金融营销材料合规审查最需要优先处理的方向。"
    },
    "financialProductContext": {
      "type": "string",
      "title": "金融产品与渠道背景",
      "x-rows": 3,
      "description": "说明产品类型、目标客群、销售渠道、地区和适用规则。",
      "x-component": "Textarea"
