          "value": "快速作战卡",
          "description": "快速作战卡级别的作战卡深度"
        },
        {
          "icon": "Target",
          "color": "blue",
          "group": "作战卡深度",
          "label": "标准作战卡",
          "value": "标准作战卡",
          "description": "标准作战卡级别的作战卡深度"
        },
        {
          "icon": "ListChecks",
          "color": "blue",
          "group": "作战卡深度",
          "label": "深度账户计划",
          "value": "深度账户计划",
          "description": "深度账户计划级别的作战卡深度"
        }
      ],
      "description": "作战卡深度"
    },
    "buyerPersona": {
      "type": "string",
