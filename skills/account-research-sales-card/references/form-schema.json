    "accountResearchFile": {
      "type": "string",
      "title": "上传账户资料",
      "format": "binary",
      "x-accept": ".docx,.pdf,.md,.txt",
      "x-max-size": 20971520,
      "description": "支持 docx、pdf、md、txt 等账户研究材料。",
